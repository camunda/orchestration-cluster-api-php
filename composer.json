{
    "name": "camunda8/orchestration-cluster-api",
    "description": "A fully typed PHP SDK for the Camunda 8 Orchestration Cluster REST API.",
    "keywords": ["camunda", "camunda8", "zeebe", "bpmn", "workflow", "orchestration", "sdk", "rest", "api"],
    "homepage": "https://github.com/camunda/orchestration-cluster-api-php",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Camunda",
            "email": "info@camunda.com",
            "homepage": "https://camunda.com"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "php-http/discovery": "^1.19",
        "php-http/multipart-stream-builder": "^1.3",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6"
    },
    "require-dev": {
        "php-http/httplug": "^2.4",
        "php-http/message": "^1.16",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "vlucas/phpdotenv": "^5.6",
        "symfony/http-client": "^7.0"
    },
    "suggest": {
        "vlucas/phpdotenv": "Load Camunda configuration from a .env file (CAMUNDA_LOAD_ENVFILE)",
        "php-http/httplug": "Enable the asynchronous CamundaAsyncClient via any HTTPlug HttpAsyncClient",
        "ext-pcntl": "Enable forked concurrency for job workers"
    },
    "autoload": {
        "psr-4": {
            "Camunda\\Orchestration\\": "src/",
            "Camunda\\Orchestration\\Api\\": "generated/src/",
            "Camunda\\Orchestration\\Semantic\\": "generated/semantic/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Camunda\\Orchestration\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite acceptance",
        "test:integration": "CAMUNDA_INTEGRATION=1 phpunit --testsuite integration",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
